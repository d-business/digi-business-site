---
export const prerender = true;
// Save as: src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import OrganicGrowthChart from '../components/OrganicGrowthChart.astro';
import { getExperienceYears } from '../lib/experience.js';

const { combined } = getExperienceYears();

const services = [
  {
    title: 'SEO and AI search',
    description:
      'Get your stock pages, used listings and dealership found on Google, Bing and AI assistants like ChatGPT.',
  },
  {
    title: 'Paid media',
    description: 'Google Ads and Meta campaigns judged on cost per enquiry, not clicks.',
  },
  {
    title: 'Reporting and automation',
    description:
      'One clear monthly report showing what drove enquiries and sales. Automation that cuts the repetitive admin, so your team spends time selling.',
  },
];
---

<BaseLayout
  title="Caravan and Motorhome Dealer Marketing | Digital Business"
  description="SEO, Ads and AI search for UK caravan, motorhome and campervan dealers. Measured in enquiries and sales. Get a free search demand report."
>
  <section class="hero">
    <div class="container hero__inner">
      <p class="eyebrow eyebrow--hero">For caravan, motorhome and campervan dealers</p>
      <h1 class="hero__heading">Digital marketing that sells more caravans, motorhomes and campervans</h1>
      <p class="hero__lead">
        UK buyers search for motorhome sales over 9,000 times a month on average. We make sure they find your stock, not the dealer down the road.
      </p>
      <div class="hero__actions">
        <a href="/contact" class="button">Get your free search demand report</a>
        <a href="#what-we-do" class="button button--outline button--outline-light">See what we do</a>
      </div>
    </div>
  </section>

  <section class="section container why">
    <div class="why__text">
      <h2>Most agencies learn your market on your money</h2>
      <p>
        A generalist agency spends months working out what an MTPLM is and how the show season shapes your year. You pay for that learning curve.
      </p>
      <p>
        Between us, we've worked in this market for <span data-experience="combined">{combined}</span> years. We know the buying cycle, the seasonal peaks and the questions buyers ask before they pick up the phone.
      </p>
      <p>That's why we only work with leisure vehicle businesses.</p>
    </div>
    <div class="why__proof">
      <div class="proof__card">
        <p class="proof__value">92%</p>
        <p class="proof__label">more visitors for a regional leisure vehicle dealer</p>
      </div>
      <div class="proof__card">
        <p class="proof__value"><span data-experience="combined">{combined}</span></p>
        <p class="proof__label">years combined in the leisure vehicle market</p>
      </div>
    </div>
  </section>

  <section class="section container practice">
    <h2>What it looks like in practice</h2>
    <h3 class="practice__client">Client: Regional Leisure Vehicle Dealer - 92% organic search growth</h3>
    <p>
      The client came to us in October 2023 with organic search delivering about 5,300 visits a month. We overhauled their SEO around real buyer demand, and organic traffic has since nearly doubled to a sustained 10,000+ visits a month.
    </p>
    <OrganicGrowthChart />
  </section>

  <section class="section container" id="what-we-do">
    <h2>What we do</h2>
    <div class="services-grid">
      {services.map((service) => (
        <div class="service-card">
          <h3>{service.title}</h3>
          <p>{service.description}</p>
        </div>
      ))}
    </div>
    <a href="/services" class="button button--dark">See services and pricing</a>
  </section>

  <section class="section container demand-row">
    <div class="demand">
      <h2>Find out what your buyers are searching for</h2>
      <p>We'll pull the search data for your area and show you:</p>
      <ul class="demand__list">
        <li>what local buyers search for, and when</li>
        <li>which of those searches you show up for</li>
        <li>where your competitors win and you don't</li>
      </ul>
      <p>No sales pitch. Just the data.</p>
      <a href="/contact" class="button">Get your free search demand report</a>
    </div>

    <div class="section--cta">
      <h2>Is this right for you?</h2>
      <p>
        We work with a small number of dealers turning over £1m to £10m. If you want more enquiries from the buyers already looking, we should talk.
      </p>
      <a href="/contact" class="button">Book a 20-minute call with Will</a>
    </div>
  </section>
</BaseLayout>

<style>
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  .hero {
    background-color: var(--color-forest);
  }

  .hero__inner {
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-xl);
  }

  .eyebrow--hero {
    color: var(--color-moss);
  }

  .hero__heading {
    color: var(--color-stone);
    max-width: 800px;
  }

  .hero__lead {
    font-size: 1.15rem;
    max-width: 640px;
    color: var(--color-stone);
  }

  .hero__actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-top: var(--space-md);
  }

  .section {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-xl);
  }

  .why {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-lg);
    align-items: center;
  }

  .why__text h2 {
    margin-top: 0;
  }

  .why__proof {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  .proof__card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-md);
  }

  .proof__value {
    font-family: var(--font-display);
    font-size: 2.5rem;
    color: var(--color-forest);
    margin: 0 0 0.25rem;
  }

  .proof__label {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .practice__client {
    font-size: 1.15rem;
    color: var(--color-accent);
    margin-bottom: var(--space-sm);
  }

  .practice :global(.growth) {
    margin-top: var(--space-md);
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-md);
    margin: var(--space-md) 0;
  }

  .service-card {
    padding-top: var(--space-sm);
    border-top: 2px solid var(--color-border);
  }

  .demand-row {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-lg);
    align-items: stretch;
  }

  .demand h2 {
    margin-top: 0;
  }

  .demand__list {
    padding-left: 1.25rem;
    margin: var(--space-sm) 0;
  }

  .section--cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    background-color: var(--color-forest);
    color: var(--color-stone);
    border-radius: var(--radius);
    padding: var(--space-xl) var(--space-md);
  }

  .section--cta h2 {
    color: var(--color-stone);
  }

  .button--outline {
    background-color: transparent;
    color: var(--color-accent);
    border: 2px solid var(--color-accent);
  }

  .button--outline:hover {
    background-color: var(--color-accent);
    color: #ffffff;
  }

  .button--outline-light {
    color: var(--color-stone);
    border-color: var(--color-stone);
  }

  .button--outline-light:hover {
    background-color: var(--color-stone);
    color: var(--color-forest);
  }

  .button--dark {
    background-color: var(--color-forest);
    color: #ffffff;
  }

  .button--dark:hover {
    background-color: var(--color-sage);
    color: #ffffff;
  }

  @media (max-width: 800px) {
    .why,
    .demand-row {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .section--cta {
      padding: var(--space-lg) var(--space-md);
    }
  }

  @media (max-width: 480px) {
    .why__proof {
      grid-template-columns: 1fr;
    }

    .proof__value {
      font-size: 2rem;
    }
  }
</style>
