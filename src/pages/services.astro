---
export const prerender = true;
// Save as: src/pages/services.astro
import BaseLayout from '../layouts/BaseLayout.astro';

const engagementOptions = [
  {
    name: 'Project-Based',
    summary: 'Defined scope, clear start and end date',
    description:
      "For work with a clear brief and finish line — a technical SEO audit, a website rebuild, a content batch, or a campaign launch. Good fit when you already know what needs doing.",
  },
  {
    name: 'Fractional / Retainer',
    summary: 'Ongoing support, built around your business',
    description:
      'SEO, paid media, content and reporting, run continuously rather than as a one-off. For outdoor leisure vehicle businesses who want consistent, compounding growth without hiring in-house.',
  },
  {
    name: 'Hourly',
    summary: 'On-call support and advisory work',
    description:
      'For existing clients who need ad hoc support, or a second opinion on your current marketing. SEO, design and development work at £150/hr; strategic consulting at £200/hr.',
  },
];
---

<BaseLayout
  title="Digital Marketing Services for Outdoor Leisure Businesses | Digital Business"
  description="Specialist SEO, Google Ads, Meta Ads and content marketing for outdoor leisure vehicle businesses. Project-based, retainer and hourly engagement options."
>
  <section class="hero">
    <div class="container hero__inner">
      <p class="eyebrow eyebrow--hero">What we offer</p>
      <h1 class="hero__heading">Services built for outdoor leisure businesses</h1>
    </div>
  </section>

  <section class="section container">
    <p class="eyebrow">Engagement options</p>
    <h2>How we work together</h2>
    <p>
      However you'd like to work with us, you get direct access to a specialist team that knows the outdoor leisure vehicle market — not a generic marketing playbook applied to your business.
    </p>

    <div class="tiers">
      {engagementOptions.map((option) => (
        <div class="tier-card">
          <h3>{option.name}</h3>
          <p class="tier-card__summary">{option.summary}</p>
          <p class="tier-card__description">{option.description}</p>
        </div>
      ))}
    </div>

    <div class="services-cta">
      <p class="services-cta__prompt">Ready to talk about your project?</p>
      <a href="/contact" class="button">Book an intro call</a>
    </div>
  </section>
</BaseLayout>

<style>
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  .hero {
    background-color: var(--color-forest);
  }

  .hero__inner {
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-xl);
  }

  .eyebrow--hero {
    color: var(--color-moss);
  }

  .hero__heading {
    color: var(--color-stone);
    max-width: 800px;
  }

  .section {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-xl);
  }

  .tiers {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-md);
    margin: var(--space-lg) 0;
  }

  .tier-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
  }

  .tier-card__summary {
    color: var(--color-accent);
    font-weight: 700;
    font-size: 0.85rem;
    margin-bottom: var(--space-xs);
  }

  .tier-card__description {
    color: var(--color-text-muted);
    margin: 0;
  }

  .services-cta {
    text-align: center;
    padding-top: var(--space-md);
  }

  .services-cta__prompt {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-heading);
    font-style: italic;
  }
</style>
